generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id            String           @id @db.Text
  slug          String           @unique @db.Text
  name          String           @db.Text
  cvr           String?          @unique @db.Text
  website       String?          @db.Text
  phone         String?          @db.Text
  email         String?          @db.Text
  status        String           @default("pending") @db.Text
  isVerified    Boolean          @default(false) @map("is_verified")
  isClaimed     Boolean          @default(false) @map("is_claimed")
  claimEmailSent Boolean         @default(false) @map("claim_email_sent")
  claimedByUserId String?        @map("claimed_by_user_id") @db.Uuid
  claimedAt     DateTime?        @map("claimed_at") @db.Timestamptz(6)
  claimEmail    String?          @map("claim_email") @db.Text
  termsAcceptedAt DateTime?      @map("terms_accepted_at") @db.Timestamptz(6)
  termsAcceptedVersion String?   @map("terms_accepted_version") @db.Text
  marketingConsent Boolean       @default(false) @map("marketing_consent")
  marketingConsentAt DateTime?   @map("marketing_consent_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastScrapedAt DateTime?        @map("last_scraped_at") @db.Timestamptz(6)
  location      CompanyLocation?
  claimedBy     User?            @relation("ClaimedCompanies", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  sources       CompanySource[]
  reviews       CompanyReview[]
  photos        CompanyPhoto[]
  claims        CompanyClaim[]
  claimTokens   CompanyClaimToken[]
  editRequests  CompanyEditRequest[]

  @@index([name], map: "companies_name_idx")
  @@index([claimedByUserId], map: "companies_claimed_by_user_id_idx")
  @@map("companies")
}

model CompanyLocation {
  companyId    String   @id @map("company_id") @db.Text
  address      String?  @db.Text
  postalCode   String?  @map("postal_code") @db.Text
  city         String?  @db.Text
  country      String   @default("Denmark") @db.Text
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  openingHours Json     @default("[]") @map("opening_hours")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([city], map: "company_locations_city_idx")
  @@map("company_locations")
}

model CompanySource {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String            @map("company_id") @db.Text
  source      String   @db.Text
  sourceUrl   String?           @map("source_url") @db.Text
  externalId  String?           @map("external_id") @db.Text
  status      String            @default("pending") @db.Text
  rating      Decimal?          @db.Decimal(3, 2)
  reviewCount Int?              @map("review_count")
  payload     Json              @default("{}")
  scrapedAt   DateTime?         @map("scraped_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, source])
  @@map("company_sources")
}

model CompanyReview {
  id              String           @id @db.Text
  companyId       String           @map("company_id") @db.Text
  source          String   @db.Text
  sourceUrl       String?          @map("source_url") @db.Text
  author          String?          @db.Text
  title           String?          @db.Text
  body            String?          @db.Text
  rating          Decimal?         @db.Decimal(3, 2)
  ratingLabel     String?          @map("rating_label") @db.Text
  reviewedAt      DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  reviewedAtLabel String?          @map("reviewed_at_label") @db.Text
  scrapedAt       DateTime         @default(now()) @map("scraped_at") @db.Timestamptz(6)
  payload         Json             @default("{}")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, source, reviewedAt(sort: Desc)], map: "company_reviews_company_source_idx")
  @@index([rating], map: "company_reviews_rating_idx")
  @@map("company_reviews")
}

model CompanyPhoto {
  id        String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String            @map("company_id") @db.Text
  source    String   @db.Text
  url       String            @db.Text
  alt       String?           @db.Text
  position  Int               @default(0)
  payload   Json              @default("{}")
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, source, url])
  @@map("company_photos")
}

model User {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String               @unique @db.Text
  name         String?              @db.Text
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  claimedCompanies Company[]         @relation("ClaimedCompanies")
  claims       CompanyClaim[]
  editRequests CompanyEditRequest[]
  sessions     UserSession[]

  @@map("users")
}

model CompanyClaim {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId           String       @map("company_id") @db.Text
  userId              String?      @map("user_id") @db.Uuid
  claimantEmail       String       @map("claimant_email") @db.Text
  claimantName        String?      @map("claimant_name") @db.Text
  status              String       @default("pending") @db.Text
  verificationMethod  String?      @map("verification_method") @db.Text
  verificationPayload Json         @default("{}") @map("verification_payload")
  termsAcceptedAt     DateTime?    @map("terms_accepted_at") @db.Timestamptz(6)
  termsAcceptedVersion String?     @map("terms_accepted_version") @db.Text
  marketingConsent    Boolean      @default(false) @map("marketing_consent")
  marketingConsentAt  DateTime?    @map("marketing_consent_at") @db.Timestamptz(6)
  expiresAt           DateTime?    @map("expires_at") @db.Timestamptz(6)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt           DateTime?    @map("decided_at") @db.Timestamptz(6)
  completedAt         DateTime?    @map("completed_at") @db.Timestamptz(6)
  company             Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, status], map: "company_claims_company_status_idx")
  @@map("company_claims")
}

model CompanyClaimToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Text
  email     String    @db.Text
  tokenHash String    @unique @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], map: "company_claim_tokens_company_id_idx")
  @@index([email], map: "company_claim_tokens_email_idx")
  @@map("company_claim_tokens")
}

model MagicLoginCode {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @db.Text
  codeHash     String    @map("code_hash") @db.Text
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, createdAt], map: "magic_login_codes_email_created_at_idx")
  @@map("magic_login_codes")
}

model UserSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "user_sessions_user_id_idx")
  @@map("user_sessions")
}

model CompanyEditRequest {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String            @map("company_id") @db.Text
  userId           String?           @map("user_id") @db.Uuid
  status           String   @default("pending") @db.Text
  requestedChanges Json              @map("requested_changes")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt        DateTime?         @map("decided_at") @db.Timestamptz(6)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("company_edit_requests")
}

model InstallerLead {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName          String   @map("full_name") @db.Text
  streetAddress     String   @map("street_address") @db.Text
  postalCode        String   @map("postal_code") @db.Text
  city              String   @db.Text
  email             String   @db.Text
  phone             String   @db.Text
  needType          String   @map("need_type") @db.Text
  message           String   @db.Text
  selectedCompanies Json     @map("selected_companies")
  emailStatus       String   @default("pending") @map("email_status") @db.Text
  errorMessage      String?  @map("error_message") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([postalCode], map: "installer_leads_postal_code_idx")
  @@map("installer_leads")
}
