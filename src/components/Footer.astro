---
import { CATEGORIES, SITE } from '../lib/constants';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-brand" href="/">
        <span class="footer-brand-mark">
          <img src="/logo.svg" alt="" width="54" height="54" loading="lazy" />
        </span>
        <span class="footer-brand-wordmark" aria-hidden="true">
          <span class="footer-brand-primary">Indeklima</span><span class="footer-brand-leaf">guiden</span>
        </span>
      </a>
      <p>Uafhængig, praktisk vejledning om aircondition, varmepumper og indeklima til danske boligejere.</p>
      <p><a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
    </div>
    <nav aria-label="Kategorier">
      <h2>Kategorier</h2>
      {Object.values(CATEGORIES).map((category) => <a href={`/${category.slug}/`}>{category.name}</a>)}
      <a href="/beregnere/">Beregnere</a>
    </nav>
    <nav aria-label="Vores guides">
      <h2>Vores guides</h2>
      <a href="https://kloakmesterguiden.dk/">Kloakmesterguiden</a>
    </nav>
    <nav aria-label="Information">
      <h2>Information</h2>
      <a href="/om-os/">Om os</a>
      <a href="/kontakt/">Kontakt</a>
      <a href="/redaktionelle-retningslinjer/">Redaktionelle retningslinjer</a>
      <a href="/annoncering-og-affiliate/">Annoncering og affiliate</a>
      <a href="/privatlivspolitik/">Privatlivspolitik</a>
      <a href="/cookiepolitik/">Cookiepolitik</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding: 3rem 0;
    background:
      radial-gradient(circle at 16% 20%, rgba(7, 155, 211, 0.24), transparent 18rem),
      radial-gradient(circle at 84% 18%, rgba(112, 182, 44, 0.2), transparent 17rem),
      linear-gradient(135deg, var(--color-primary), #06263f 72%);
    color: #eaf1ff;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2rem;
  }

  .site-footer .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
    color: #fff;
    font-size: clamp(1.08rem, 2vw, 1.45rem);
    font-weight: 900;
    line-height: 1;
    text-decoration: none;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .footer-brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 54px;
    height: 54px;
    background: #fff;
    box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.18);
  }

  .footer-brand img {
    width: 54px;
    height: 54px;
    object-fit: contain;
  }

  .site-footer .footer-brand .footer-brand-primary {
    color: #fff;
  }

  .footer-brand-wordmark {
    line-height: 1;
  }

  .site-footer .footer-brand .footer-brand-leaf {
    color: var(--color-leaf-dark);
  }

  .site-footer .footer-brand .footer-brand-dot {
    color: var(--color-accent-dark);
  }

  .site-footer h2 {
    margin: 0 0 0.8rem;
    color: #fff;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .site-footer a,
  .site-footer button {
    display: block;
    margin: 0.35rem 0;
    border: 0;
    padding: 0;
    background: transparent;
    color: #eaf1ff;
    cursor: pointer;
    font: inherit;
    text-align: left;
  }

  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
