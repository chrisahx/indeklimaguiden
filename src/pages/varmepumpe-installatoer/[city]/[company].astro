---
export const prerender = false;

import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CompanyRatingBadge from '../../../components/CompanyRatingBadge.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPrisma } from '../../../lib/prisma';
import { slugifyCity } from '../../../lib/slugs';

interface CityRow {
  city_name: string;
}

interface CompanyRow {
  id: string;
  slug: string;
  name: string;
  website: string | null;
  phone: string | null;
  email: string | null;
  cvr: string | null;
  status: string;
  is_claimed: boolean;
  address: string | null;
  postal_code: string | null;
  city: string;
  country: string;
  latitude: string | null;
  longitude: string | null;
  google_rating: string | null;
  google_review_count: number | null;
  google_source_url: string | null;
  trustpilot_rating: string | null;
  trustpilot_review_count: number | null;
  trustpilot_source_url: string | null;
}

interface CompanyReviewRow {
  source: 'google' | 'trustpilot';
  source_url: string | null;
  author: string | null;
  title: string | null;
  body: string | null;
  rating: string | null;
  rating_label: string | null;
  reviewed_at_display: string | null;
}

const citySlug = Astro.params.city ?? '';
const companySlug = Astro.params.company ?? '';
let cityName = '';
let company: CompanyRow | null = null;
let reviews: CompanyReviewRow[] = [];
let dbError = '';

try {
  const prisma = getPrisma();
  const cityRows = await prisma.$queryRaw<CityRow[]>`
    select min(trim(company_locations.city)) as city_name
    from company_locations
    join companies on companies.id = company_locations.company_id
    where nullif(trim(company_locations.city), '') is not null
    group by lower(trim(company_locations.city))
    order by city_name asc
  `;

  const matchedCity = cityRows.find((row) => slugifyCity(row.city_name) === citySlug);

  if (!matchedCity) {
    return new Response('Byen blev ikke fundet.', { status: 404 });
  }

  cityName = matchedCity.city_name;

  const rows = await prisma.$queryRaw<CompanyRow[]>`
    select
      companies.id,
      companies.slug,
      companies.name,
      companies.website,
      companies.phone,
      companies.email,
      companies.cvr,
      companies.status,
      companies.is_claimed,
      company_locations.address,
      company_locations.postal_code,
      trim(company_locations.city) as city,
      company_locations.country,
      company_locations.latitude::text as latitude,
      company_locations.longitude::text as longitude,
      google.rating::text as google_rating,
      google.review_count as google_review_count,
      google.source_url as google_source_url,
      trustpilot.rating::text as trustpilot_rating,
      trustpilot.review_count as trustpilot_review_count,
      trustpilot.source_url as trustpilot_source_url
    from companies
    join company_locations on company_locations.company_id = companies.id
    left join company_sources google
      on google.company_id = companies.id and google.source = 'google'
    left join company_sources trustpilot
      on trustpilot.company_id = companies.id and trustpilot.source = 'trustpilot'
    where companies.slug = ${companySlug}
      and lower(trim(company_locations.city)) = lower(trim(${cityName}))
    limit 1
  `;

  company = rows[0] ?? null;

  if (!company) {
    return new Response('Virksomheden blev ikke fundet.', { status: 404 });
  }

  reviews = await prisma.$queryRaw<CompanyReviewRow[]>`
    select
      source,
      source_url,
      author,
      title,
      body,
      rating::text as rating,
      rating_label,
      reviewed_at_display
    from (
      select
        company_reviews.source,
        company_reviews.source_url,
        company_reviews.author,
        company_reviews.title,
        company_reviews.body,
        company_reviews.rating,
        company_reviews.rating_label,
        coalesce(
          company_reviews.reviewed_at_label,
          to_char(company_reviews.reviewed_at at time zone 'Europe/Copenhagen', 'DD.MM.YYYY')
        ) as reviewed_at_display,
        row_number() over (
          partition by company_reviews.source
          order by company_reviews.reviewed_at desc nulls last, company_reviews.created_at desc
        ) as source_rank
      from company_reviews
      where company_reviews.company_id = ${company.id}
        and company_reviews.source in ('google', 'trustpilot')
    ) ranked_reviews
    where source_rank <= 20
    order by source asc, source_rank asc
  `;
} catch (error) {
  dbError = error instanceof Error ? error.message : 'Kunne ikke hente virksomheden fra databasen.';
}

const title = company ? `${company.name} - varmepumpe installatør i ${cityName}` : 'Varmepumpe installatør';
const description = company
  ? `Se kontaktoplysninger, adresse, CVR og anmeldelsesdata for ${company.name} i ${cityName}.`
  : 'Se kontaktoplysninger og anmeldelsesdata for en varmepumpe installatør.';
const fullAddress = company ? [company.address, company.postal_code, company.city].filter(Boolean).join(', ') : '';
const googleReviews = reviews.filter((review) => review.source === 'google');
const trustpilotReviews = reviews.filter((review) => review.source === 'trustpilot');
const getRatingValue = (rating: string | null) => {
  const ratingNumber = Number(rating);
  return Number.isFinite(ratingNumber) ? Math.max(0, Math.min(5, ratingNumber)) : null;
};
---

<BaseLayout title={title} description={description} path={`/varmepumpe-installatoer/${citySlug}/${companySlug}/`}>
  <section class="section container company-hero">
    <Breadcrumbs items={[{ name: 'Forside', url: '/' }, { name: 'Varmepumpe installatører', url: '/varmepumpe-installatoer/' }, { name: cityName || 'By', url: `/varmepumpe-installatoer/${citySlug}/` }, { name: company?.name || 'Virksomhed', url: `/varmepumpe-installatoer/${citySlug}/${companySlug}/` }]} />

    {dbError ? (
      <div class="surface notice" role="alert">
        <strong>Databaseforbindelsen mangler eller fejlede.</strong>
        <p>{dbError}</p>
      </div>
    ) : company && (
      <div class="company-hero__grid">
        <div>
          <span class="pill">Virksomhedsprofil</span>
          <h1>{company.name}</h1>
          <p>
            Se offentligt indsamlede oplysninger om {company.name}, herunder kontaktdata, adresse, CVR og anmeldelsesdata fra Google og Trustpilot.
          </p>
          <div class="ratings">
            <CompanyRatingBadge source="google" rating={company.google_rating} reviewCount={company.google_review_count} />
            <CompanyRatingBadge source="trustpilot" rating={company.trustpilot_rating} reviewCount={company.trustpilot_review_count} />
          </div>
        </div>

        <aside class="surface contact-card" aria-label="Kontaktoplysninger">
          <h2>Kontakt</h2>
          <div class="contact-actions">
            {company.website && <a class="button" href={company.website} rel="nofollow noopener" target="_blank">Besøg website</a>}
            {company.phone && <a class="button secondary" href={`tel:${company.phone.replace(/\s+/g, '')}`}>{company.phone}</a>}
            {company.email && <a class="button secondary" href={`mailto:${company.email}`}>Send mail</a>}
          </div>
        </aside>
      </div>
    )}
  </section>

  {company && !dbError && (
    <>
      <section class="container detail-section">
        <div class="surface info-card" data-company-data-card>
          <h2>Virksomhedsdata</h2>
          <dl class="info-grid">
            <div><dt>Navn</dt><dd>{company.name}</dd></div>
            <div><dt>Adresse</dt><dd>{fullAddress || 'Ikke oplyst'}</dd></div>
            <div><dt>CVR</dt><dd>{company.cvr || 'Ikke oplyst'}</dd></div>
            <div><dt>By</dt><dd>{company.city}</dd></div>
            <div><dt>Land</dt><dd>{company.country}</dd></div>
            <div><dt>Status</dt><dd>{company.status}</dd></div>
            <div><dt>Profil verificeret</dt><dd>{company.is_claimed ? 'Ja' : 'Nej'}</dd></div>
            <div><dt>Koordinater</dt><dd>{company.latitude && company.longitude ? `${company.latitude}, ${company.longitude}` : 'Ikke oplyst'}</dd></div>
          </dl>
        </div>

        <div class="surface info-card reviews-card" data-reviews-card>
          <h2>Anmeldelsesdata</h2>

          <div class="review-tabs" role="tablist" aria-label="Anmeldelseskilder">
            <button class="review-tab is-active" type="button" role="tab" id="google-reviews-tab" aria-controls="google-reviews-panel" aria-selected="true" data-review-tab="google">Google anmeldelser</button>
            <button class="review-tab" type="button" role="tab" id="trustpilot-reviews-tab" aria-controls="trustpilot-reviews-panel" aria-selected="false" data-review-tab="trustpilot">Trustpilot anmeldelser</button>
          </div>

          <div class="review-panel" role="tabpanel" id="google-reviews-panel" aria-labelledby="google-reviews-tab" data-review-panel="google">
            <div class="review-panel__summary">
              <CompanyRatingBadge source="google" rating={company.google_rating} reviewCount={company.google_review_count} />
              {company.google_source_url && <a href={company.google_source_url} rel="nofollow noopener" target="_blank">Se Google-kilde</a>}
            </div>

            {googleReviews.length > 0 ? (
              <div class="review-list" aria-label="Google anmeldelser">
                {googleReviews.map((review) => {
                  const ratingValue = getRatingValue(review.rating);

                  return (
                    <article class="review-item">
                      <header class="review-item__header">
                        <div>
                          <h3>{review.author || 'Anonym anmelder'}</h3>
                          {review.reviewed_at_display && <p>{review.reviewed_at_display}</p>}
                        </div>
                        {ratingValue !== null && (
                          <span class="review-item__rating" aria-label={`${ratingValue.toFixed(1)} ud af 5 stjerner`}>
                            <strong>{ratingValue.toFixed(1)}</strong>
                            <span aria-hidden="true">
                              {[1, 2, 3, 4, 5].map((star) => <span class={star <= Math.round(ratingValue) ? 'is-filled' : ''}>★</span>)}
                            </span>
                          </span>
                        )}
                      </header>
                      {review.title && <strong class="review-item__title">{review.title}</strong>}
                      {review.body && <p class="review-item__body">{review.body}</p>}
                      {review.source_url && <a class="review-item__link" href={review.source_url} rel="nofollow noopener" target="_blank">Læs original anmeldelse</a>}
                    </article>
                  );
                })}
              </div>
            ) : (
              <p class="empty-reviews">Der er endnu ingen importerede Google-anmeldelser.</p>
            )}
          </div>

          <div class="review-panel" role="tabpanel" id="trustpilot-reviews-panel" aria-labelledby="trustpilot-reviews-tab" data-review-panel="trustpilot" hidden>
            <div class="review-panel__summary">
              <CompanyRatingBadge source="trustpilot" rating={company.trustpilot_rating} reviewCount={company.trustpilot_review_count} />
              {company.trustpilot_source_url && <a href={company.trustpilot_source_url} rel="nofollow noopener" target="_blank">Se Trustpilot-kilde</a>}
            </div>

            {trustpilotReviews.length > 0 ? (
              <div class="review-list" aria-label="Trustpilot anmeldelser">
                {trustpilotReviews.map((review) => {
                  const ratingValue = getRatingValue(review.rating);

                  return (
                    <article class="review-item review-item--trustpilot">
                      <header class="review-item__header">
                        <div>
                          <h3>{review.author || 'Anonym anmelder'}</h3>
                          {review.reviewed_at_display && <p>{review.reviewed_at_display}</p>}
                        </div>
                        {ratingValue !== null && (
                          <span class="review-item__rating" aria-label={`${ratingValue.toFixed(1)} ud af 5 stjerner`}>
                            <strong>{ratingValue.toFixed(1)}</strong>
                            <span aria-hidden="true">
                              {[1, 2, 3, 4, 5].map((star) => <span class={star <= Math.round(ratingValue) ? 'is-filled' : ''}>★</span>)}
                            </span>
                          </span>
                        )}
                      </header>
                      {review.title && <strong class="review-item__title">{review.title}</strong>}
                      {review.body && <p class="review-item__body">{review.body}</p>}
                      {review.source_url && <a class="review-item__link" href={review.source_url} rel="nofollow noopener" target="_blank">Læs original anmeldelse</a>}
                    </article>
                  );
                })}
              </div>
            ) : (
              <p class="empty-reviews">Der er endnu ingen importerede Trustpilot-anmeldelser.</p>
            )}
          </div>
        </div>
      </section>

      <section class="container disclosure surface">
        <h2>Om data i profilen</h2>
        <p>Data er indsamlet fra offentligt tilgængelige kilder og kan ændre sig. Kontakt altid virksomheden direkte for at bekræfte ydelser, priser, certificeringer og tilgængelighed.</p>
      </section>
    </>
  )}
</BaseLayout>

<style>
  .company-hero { padding-bottom: clamp(2rem, 4vw, 3rem); }
  .company-hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 0.34fr); gap: clamp(1.25rem, 4vw, 2.5rem); align-items: start; }
  .company-hero p { max-width: 820px; color: var(--color-muted); font-size: clamp(1.08rem, 2vw, 1.26rem); }
  .ratings { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
  .contact-card { padding: clamp(1rem, 2vw, 1.35rem); }
  .contact-card h2 { margin: 0 0 1rem; font-size: 1.35rem; }
  .contact-actions { display: grid; gap: 0.65rem; }
  .contact-actions .button { width: 100%; padding: 0.75rem 1rem; }
  .detail-section { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.75fr); gap: 1rem; align-items: stretch; padding-bottom: clamp(2rem, 5vw, 4rem); }
  .info-card { padding: clamp(1rem, 2vw, 1.35rem); }
  .info-card h2 { margin: 0 0 1rem; font-size: clamp(1.45rem, 2.6vw, 2rem); }
  .info-grid { display: grid; gap: 0.75rem; margin: 0; }
  .info-grid div { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 1rem; border-top: 1px solid var(--color-border); padding-top: 0.75rem; }
  .info-grid dt { color: var(--color-muted); font-weight: 900; }
  .info-grid dd { margin: 0; color: var(--color-primary); font-weight: 800; overflow-wrap: anywhere; }
  .reviews-card { display: flex; flex-direction: column; min-height: 0; overflow: hidden; }
  .review-tabs { display: flex; gap: 0.25rem; border: 1px solid var(--color-border); border-radius: 999px; background: color-mix(in srgb, var(--color-surface-strong) 78%, var(--color-background)); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72); margin-top: 0.2rem; padding: 0.25rem; }
  .review-tab { flex: 1 1 0; border: 0; border-radius: 999px; background: transparent; color: var(--color-muted); cursor: pointer; font: inherit; font-size: 0.86rem; font-weight: 900; letter-spacing: -0.01em; padding: 0.58rem 0.8rem; transition: background 160ms ease, box-shadow 160ms ease, color 160ms ease, transform 160ms ease; }
  .review-tab:hover, .review-tab:focus-visible { color: var(--color-primary); }
  .review-tab:focus-visible { outline: 2px solid color-mix(in srgb, var(--color-primary) 34%, transparent); outline-offset: 2px; }
  .review-tab.is-active { background: var(--color-primary); box-shadow: 0 10px 24px rgba(10, 52, 83, 0.16); color: var(--color-surface-strong); }
  .review-panel { display: grid; gap: 1rem; min-height: 0; margin-top: 1rem; overflow-y: auto; padding-right: 0.35rem; scrollbar-color: color-mix(in srgb, var(--color-primary) 35%, transparent) transparent; }
  .review-panel[hidden] { display: none; }
  .review-panel__summary { display: grid; gap: 0.6rem; justify-items: start; }
  .review-panel__summary a, .review-item__link { color: var(--color-primary); font-weight: 900; }
  .review-list { display: grid; gap: 0.85rem; }
  .review-item { display: grid; gap: 0.65rem; border: 1px solid var(--color-border); border-radius: 1rem; background: color-mix(in srgb, var(--color-surface-strong) 72%, transparent); padding: 0.9rem; }
  .review-item__header { display: flex; justify-content: space-between; gap: 0.8rem; align-items: flex-start; }
  .review-item h3 { margin: 0; color: var(--color-primary); font-size: 1rem; }
  .review-item__header p, .review-item__body, .empty-reviews { margin: 0; color: var(--color-muted); }
  .review-item__header p { font-size: 0.9rem; font-weight: 800; }
  .review-item__rating { display: inline-flex; align-items: center; gap: 0.3rem; color: color-mix(in srgb, var(--color-muted) 34%, transparent); font-size: 0.78rem; white-space: nowrap; }
  .review-item__rating strong { color: var(--color-primary); font-size: 0.95rem; }
  .review-item__rating .is-filled { color: #fbbc04; }
  .review-item--trustpilot .review-item__rating .is-filled { color: #00b67a; }
  .review-item__title { color: var(--color-primary); font-size: 0.98rem; }
  .review-item__body { line-height: 1.6; }
  .notice { padding: 1.25rem; }
  .notice strong { color: var(--color-primary); }
  .notice p { margin: 0.5rem 0 0; color: var(--color-muted); }
  .disclosure { margin-bottom: clamp(3.5rem, 7vw, 7rem); padding: 1.25rem; }
  .disclosure h2 { margin: 0 0 0.75rem; font-size: 1.35rem; }
  .disclosure p { margin: 0; color: var(--color-muted); }
  @media (max-width: 860px) { .company-hero__grid, .detail-section { grid-template-columns: 1fr; } .reviews-card { height: auto !important; } .review-panel { max-height: 520px; } }
  @media (max-width: 560px) { .info-grid div { grid-template-columns: 1fr; gap: 0.25rem; } .review-tabs { border-radius: 1rem; flex-direction: column; } .review-tab { border-radius: 0.75rem; } .review-item__header { display: grid; } }
</style>

<script>
  const companyDataCard = document.querySelector<HTMLElement>('[data-company-data-card]');
  const reviewsCard = document.querySelector<HTMLElement>('[data-reviews-card]');
  const reviewTabButtons = document.querySelectorAll('[data-review-tab]');
  const reviewPanels = document.querySelectorAll('[data-review-panel]');

  const syncReviewCardHeight = () => {
    if (!companyDataCard || !reviewsCard || window.matchMedia('(max-width: 860px)').matches) {
      if (reviewsCard) reviewsCard.style.height = '';
      return;
    }

    reviewsCard.style.height = `${companyDataCard.offsetHeight}px`;
  };

  syncReviewCardHeight();

  if (companyDataCard && 'ResizeObserver' in window) {
    new ResizeObserver(syncReviewCardHeight).observe(companyDataCard);
  }

  window.addEventListener('resize', syncReviewCardHeight);

  reviewTabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedTab = button.getAttribute('data-review-tab');

      reviewTabButtons.forEach((tabButton) => {
        const isSelected = tabButton.getAttribute('data-review-tab') === selectedTab;
        tabButton.classList.toggle('is-active', isSelected);
        tabButton.setAttribute('aria-selected', String(isSelected));
      });

      reviewPanels.forEach((panel) => {
        panel.toggleAttribute('hidden', panel.getAttribute('data-review-panel') !== selectedTab);
      });

      syncReviewCardHeight();
    });
  });
</script>
