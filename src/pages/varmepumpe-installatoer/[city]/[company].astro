<script>
  import * as L from 'leaflet';

  const mapElement = document.querySelector<HTMLElement>('[data-company-map]');
  const companyDataCard = document.querySelector<HTMLElement>('[data-company-data-card]');
  const reviewsCard = document.querySelector<HTMLElement>('[data-reviews-card]');
  const reviewTabButtons = document.querySelectorAll('[data-review-tab]');
  const reviewPanels = document.querySelectorAll('[data-review-panel]');

  document.querySelectorAll<HTMLElement>('[data-phone-reveal]').forEach((phoneReveal) => {
    const revealButton = phoneReveal.querySelector<HTMLButtonElement>('[data-phone-reveal-button]');
    const phoneLink = phoneReveal.querySelector<HTMLAnchorElement>('[data-phone-link]');

    if (!revealButton || !phoneLink) return;

    phoneLink.hidden = true;
    revealButton.hidden = false;

    revealButton.addEventListener('click', () => {
      revealButton.hidden = true;
      phoneLink.hidden = false;
      phoneLink.focus();
    });
  });

  if (mapElement) {
    const latitude = Number(mapElement.dataset.lat);
    const longitude = Number(mapElement.dataset.lng);
    const companyName = mapElement.dataset.name || 'Virksomhed';

    if (Number.isFinite(latitude) && Number.isFinite(longitude)) {
      const map = L.map(mapElement, { scrollWheelZoom: false }).setView([latitude, longitude], 14);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      }).addTo(map);

      const markerIcon = L.divIcon({
        className: 'company-map__marker',
        html: '',
        iconSize: [34, 34],
        iconAnchor: [17, 34],
        popupAnchor: [0, -30],
      });

      L.marker([latitude, longitude], { icon: markerIcon }).addTo(map).bindPopup(companyName);

      setTimeout(() => map.invalidateSize(), 150);
    }
  }

  document.querySelectorAll<HTMLElement>('[data-photo-carousel]').forEach((carousel) => {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]'));
    const previousButton = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const nextButton = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const counter = carousel.querySelector<HTMLElement>('[data-carousel-counter]');
    let activeIndex = 0;

    const renderSlide = () => {
      slides.forEach((slide, index) => {
        slide.toggleAttribute('hidden', index !== activeIndex);
      });

      if (counter) {
        counter.textContent = `${activeIndex + 1} / ${slides.length}`;
      }
    };

    previousButton?.addEventListener('click', () => {
      activeIndex = activeIndex === 0 ? slides.length - 1 : activeIndex - 1;
      renderSlide();
    });

    nextButton?.addEventListener('click', () => {
      activeIndex = activeIndex === slides.length - 1 ? 0 : activeIndex + 1;
      renderSlide();
    });
  });

  const syncReviewCardHeight = () => {
    if (!companyDataCard || !reviewsCard || window.matchMedia('(max-width: 860px)').matches) {
      if (reviewsCard) reviewsCard.style.height = '';
      return;
    }

    reviewsCard.style.height = `${companyDataCard.offsetHeight}px`;
  };

  syncReviewCardHeight();

  if (companyDataCard && 'ResizeObserver' in window) {
    new ResizeObserver(syncReviewCardHeight).observe(companyDataCard);
  }

  window.addEventListener('resize', syncReviewCardHeight);

  reviewTabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedTab = button.getAttribute('data-review-tab');

      reviewTabButtons.forEach((tabButton) => {
        const isSelected = tabButton.getAttribute('data-review-tab') === selectedTab;
        tabButton.classList.toggle('is-active', isSelected);
        tabButton.setAttribute('aria-selected', String(isSelected));
      });

      reviewPanels.forEach((panel) => {
        panel.toggleAttribute('hidden', panel.getAttribute('data-review-panel') !== selectedTab);
      });

      syncReviewCardHeight();
    });
  });
</script>
