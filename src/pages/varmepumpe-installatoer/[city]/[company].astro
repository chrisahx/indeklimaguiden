---
export const prerender = false;

import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CompanyRatingBadge from '../../../components/CompanyRatingBadge.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPrisma } from '../../../lib/prisma';
import { slugifyCity } from '../../../lib/slugs';

interface CityRow {
  city_name: string;
}

interface CompanyRow {
  id: string;
  slug: string;
  name: string;
  website: string | null;
  phone: string | null;
  email: string | null;
  cvr: string | null;
  status: string;
  is_claimed: boolean;
  address: string | null;
  postal_code: string | null;
  city: string;
  country: string;
  latitude: string | null;
  longitude: string | null;
  google_rating: string | null;
  google_review_count: number | null;
  google_source_url: string | null;
  trustpilot_rating: string | null;
  trustpilot_review_count: number | null;
  trustpilot_source_url: string | null;
}

const citySlug = Astro.params.city ?? '';
const companySlug = Astro.params.company ?? '';
let cityName = '';
let company: CompanyRow | null = null;
let dbError = '';

try {
  const prisma = getPrisma();
  const cityRows = await prisma.$queryRaw<CityRow[]>`
    select min(trim(company_locations.city)) as city_name
    from company_locations
    join companies on companies.id = company_locations.company_id
    where nullif(trim(company_locations.city), '') is not null
    group by lower(trim(company_locations.city))
    order by city_name asc
  `;

  const matchedCity = cityRows.find((row) => slugifyCity(row.city_name) === citySlug);

  if (!matchedCity) {
    return new Response('Byen blev ikke fundet.', { status: 404 });
  }

  cityName = matchedCity.city_name;

  const rows = await prisma.$queryRaw<CompanyRow[]>`
    select
      companies.id,
      companies.slug,
      companies.name,
      companies.website,
      companies.phone,
      companies.email,
      companies.cvr,
      companies.status,
      companies.is_claimed,
      company_locations.address,
      company_locations.postal_code,
      trim(company_locations.city) as city,
      company_locations.country,
      company_locations.latitude::text as latitude,
      company_locations.longitude::text as longitude,
      google.rating::text as google_rating,
      google.review_count as google_review_count,
      google.source_url as google_source_url,
      trustpilot.rating::text as trustpilot_rating,
      trustpilot.review_count as trustpilot_review_count,
      trustpilot.source_url as trustpilot_source_url
    from companies
    join company_locations on company_locations.company_id = companies.id
    left join company_sources google
      on google.company_id = companies.id and google.source = 'google'
    left join company_sources trustpilot
      on trustpilot.company_id = companies.id and trustpilot.source = 'trustpilot'
    where companies.slug = ${companySlug}
      and lower(trim(company_locations.city)) = lower(trim(${cityName}))
    limit 1
  `;

  company = rows[0] ?? null;

  if (!company) {
    return new Response('Virksomheden blev ikke fundet.', { status: 404 });
  }
} catch (error) {
  dbError = error instanceof Error ? error.message : 'Kunne ikke hente virksomheden fra databasen.';
}

const title = company ? `${company.name} - varmepumpe installatør i ${cityName}` : 'Varmepumpe installatør';
const description = company
  ? `Se kontaktoplysninger, adresse, CVR og anmeldelsesdata for ${company.name} i ${cityName}.`
  : 'Se kontaktoplysninger og anmeldelsesdata for en varmepumpe installatør.';
const fullAddress = company ? [company.address, company.postal_code, company.city].filter(Boolean).join(', ') : '';
---

<BaseLayout title={title} description={description} path={`/varmepumpe-installatoer/${citySlug}/${companySlug}/`}>
  <section class="section container company-hero">
    <Breadcrumbs items={[{ name: 'Forside', url: '/' }, { name: 'Varmepumpe installatører', url: '/varmepumpe-installatoer/' }, { name: cityName || 'By', url: `/varmepumpe-installatoer/${citySlug}/` }, { name: company?.name || 'Virksomhed', url: `/varmepumpe-installatoer/${citySlug}/${companySlug}/` }]} />

    {dbError ? (
      <div class="surface notice" role="alert">
        <strong>Databaseforbindelsen mangler eller fejlede.</strong>
        <p>{dbError}</p>
      </div>
    ) : company && (
      <div class="company-hero__grid">
        <div>
          <span class="pill">Virksomhedsprofil</span>
          <h1>{company.name}</h1>
          <p>
            Se offentligt indsamlede oplysninger om {company.name}, herunder kontaktdata, adresse, CVR og anmeldelsesdata fra Google og Trustpilot.
          </p>
          <div class="ratings">
            <CompanyRatingBadge source="google" rating={company.google_rating} reviewCount={company.google_review_count} />
            <CompanyRatingBadge source="trustpilot" rating={company.trustpilot_rating} reviewCount={company.trustpilot_review_count} />
          </div>
        </div>

        <aside class="surface contact-card" aria-label="Kontaktoplysninger">
          <h2>Kontakt</h2>
          <div class="contact-actions">
            {company.website && <a class="button" href={company.website} rel="nofollow noopener" target="_blank">Besøg website</a>}
            {company.phone && <a class="button secondary" href={`tel:${company.phone.replace(/\s+/g, '')}`}>{company.phone}</a>}
            {company.email && <a class="button secondary" href={`mailto:${company.email}`}>Send mail</a>}
          </div>
        </aside>
      </div>
    )}
  </section>

  {company && !dbError && (
    <>
      <section class="container detail-section">
        <div class="surface info-card">
          <h2>Virksomhedsdata</h2>
          <dl class="info-grid">
            <div><dt>Navn</dt><dd>{company.name}</dd></div>
            <div><dt>Adresse</dt><dd>{fullAddress || 'Ikke oplyst'}</dd></div>
            <div><dt>CVR</dt><dd>{company.cvr || 'Ikke oplyst'}</dd></div>
            <div><dt>By</dt><dd>{company.city}</dd></div>
            <div><dt>Land</dt><dd>{company.country}</dd></div>
            <div><dt>Status</dt><dd>{company.status}</dd></div>
            <div><dt>Profil verificeret</dt><dd>{company.is_claimed ? 'Ja' : 'Nej'}</dd></div>
            <div><dt>Koordinater</dt><dd>{company.latitude && company.longitude ? `${company.latitude}, ${company.longitude}` : 'Ikke oplyst'}</dd></div>
          </dl>
        </div>

        <div class="surface info-card">
          <h2>Anmeldelsesdata</h2>
          <div class="review-sources">
            <div class="review-source">
              <CompanyRatingBadge source="google" rating={company.google_rating} reviewCount={company.google_review_count} />
              {company.google_source_url && <a href={company.google_source_url} rel="nofollow noopener" target="_blank">Se Google-kilde</a>}
            </div>
            <div class="review-source">
              <CompanyRatingBadge source="trustpilot" rating={company.trustpilot_rating} reviewCount={company.trustpilot_review_count} />
              {company.trustpilot_source_url && <a href={company.trustpilot_source_url} rel="nofollow noopener" target="_blank">Se Trustpilot-kilde</a>}
            </div>
          </div>
        </div>
      </section>

      <section class="container disclosure surface">
        <h2>Om data i profilen</h2>
        <p>Data er indsamlet fra offentligt tilgængelige kilder og kan ændre sig. Kontakt altid virksomheden direkte for at bekræfte ydelser, priser, certificeringer og tilgængelighed.</p>
      </section>
    </>
  )}
</BaseLayout>

<style>
  .company-hero { padding-bottom: clamp(2rem, 4vw, 3rem); }
  .company-hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 0.34fr); gap: clamp(1.25rem, 4vw, 2.5rem); align-items: start; }
  .company-hero p { max-width: 820px; color: var(--color-muted); font-size: clamp(1.08rem, 2vw, 1.26rem); }
  .ratings { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
  .contact-card { padding: clamp(1rem, 2vw, 1.35rem); }
  .contact-card h2 { margin: 0 0 1rem; font-size: 1.35rem; }
  .contact-actions { display: grid; gap: 0.65rem; }
  .contact-actions .button { width: 100%; padding: 0.75rem 1rem; }
  .detail-section { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.75fr); gap: 1rem; padding-bottom: clamp(2rem, 5vw, 4rem); }
  .info-card { padding: clamp(1rem, 2vw, 1.35rem); }
  .info-card h2 { margin: 0 0 1rem; font-size: clamp(1.45rem, 2.6vw, 2rem); }
  .info-grid { display: grid; gap: 0.75rem; margin: 0; }
  .info-grid div { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 1rem; border-top: 1px solid var(--color-border); padding-top: 0.75rem; }
  .info-grid dt { color: var(--color-muted); font-weight: 900; }
  .info-grid dd { margin: 0; color: var(--color-primary); font-weight: 800; overflow-wrap: anywhere; }
  .review-sources { display: grid; gap: 1rem; }
  .review-source { display: grid; gap: 0.55rem; justify-items: start; border-top: 1px solid var(--color-border); padding-top: 0.85rem; }
  .review-source a { color: var(--color-primary); font-weight: 900; }
  .notice { padding: 1.25rem; }
  .notice strong { color: var(--color-primary); }
  .notice p { margin: 0.5rem 0 0; color: var(--color-muted); }
  .disclosure { margin-bottom: clamp(3.5rem, 7vw, 7rem); padding: 1.25rem; }
  .disclosure h2 { margin: 0 0 0.75rem; font-size: 1.35rem; }
  .disclosure p { margin: 0; color: var(--color-muted); }
  @media (max-width: 860px) { .company-hero__grid, .detail-section { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .info-grid div { grid-template-columns: 1fr; gap: 0.25rem; } }
</style>
